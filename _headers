# Global Security and Cache Control Rules
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: no-referrer-when-downgrade
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: svg+xml; media-src 'self'; connect-src 'self' https://api.aladhan.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Permissions-Policy: accelerometer=(), camera=(), geometric-sensors=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Powered-By: AXION Neuralis Infrastructure

# Long Cache Duration for Core Assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache configurations for Fonts
https://fonts.gstatic.com/*
  Cache-Control: public, max-age=31536000, immutable

# Prevent Caching of Core Router Files to ensure instant updates
/js/main.js
  Cache-Control: no-cache, no-store, must-revalidate

/data/events.json
  Cache-Control: no-cache, no-store, must-revalidate